# Sao chep file nay thanh ".env.local" roi dien gia tri that vao.
# Next.js chi expose bien co tien to NEXT_PUBLIC_ ra trinh duyet (client) -
# BAT BUOC giu dung tien to nay, khong duoc doi ten.

# Dia chi WebSocket cua Mosquitto Broker (xem mosquitto/mosquitto.conf)
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001

# Cau hinh Firebase - lay tu Firebase Console > Project settings > General
# > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
